# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Required in production. Leave unset to use SQLite locally.
POSTGRES_HOST=your-db-host
POSTGRES_PORT=5432
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=fitness_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set this to your Vercel frontend URL (e.g. https://fittrack.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
